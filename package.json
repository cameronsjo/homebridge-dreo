{
  "displayName": "Homebridge Dreo",
  "name": "homebridge-dreo",
  "version": "4.2.0",
  "description": "Homebridge Plugin for Dreo Smart Devices",
  "homepage": "https://github.com/zyonse/homebridge-dreo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyonse/homebridge-dreo.git"
  },
  "bugs": {
    "url": "https://github.com/zyonse/homebridge-dreo/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/zyonse"
  },
  "engines": {
    "node": ">=14.18.1",
    "homebridge": "^1.3.5 || ^2.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "dreo",
    "fan",
    "tower"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "crypto-js": "^4.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.1",
    "homebridge": "^1.3.5",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
